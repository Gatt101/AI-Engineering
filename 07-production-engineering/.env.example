# Copy to .env, then set your key locally. Never commit the real .env.
OPENAI_API_KEY=
# Example from the official quickstart checked during implementation.
# Set a Responses-compatible model available to your API project.
OPENAI_MODEL=gpt-6-astra
REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024
DATABASE_URL=sqlite:///./researchops.db
ENVIRONMENT=local
# Explicit synthetic-data demonstration, bearer token: local-demo-token.
DEMO_MODE=false
# JSON object mapping SHA256(token) to actor_id, tenant_id, permissions.
API_PRINCIPALS={}
AUTO_MIGRATE=true
MAX_PENDING_RUNS=100
MAX_REQUEST_BYTES=131072
MAX_CONCURRENT_REQUESTS=16
REQUESTS_PER_MINUTE=120
